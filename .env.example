# --- DWG conversion ----------------------------------------------------------
# auto | oda | libredwg | none
DWG_CONVERTER=auto
ODA_FILE_CONVERTER_PATH=
LIBREDWG_DWG2DXF_PATH=
CONVERTER_TIMEOUT_S=120

# --- Local LLM (OpenAI-compatible; Ollama / llama.cpp server / vLLM) ----------
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=
LOCAL_LLM_ENABLED=true

# --- Placement ----------------------------------------------------------------
PLACEMENT_RANDOM_SEED=42
MAX_ITERATIONS=3
LOCAL_LLM_TIMEOUT_S=180

# --- GPT evaluator (offline dev/CI only — NEVER used at runtime) --------------
# The eval runner probes GET $OPENAI_BASE_URL/models for OPENAI_EVAL_MODEL.
# Missing key or absent model => CapabilityError / "SKIPPED (capability: ...)".
# There is NO silent fallback to another model by design.
OPENAI_EVAL_MODEL=gpt-6
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
