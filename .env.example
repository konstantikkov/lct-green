# --- DWG conversion ----------------------------------------------------------
# auto | oda | libredwg | none
DWG_CONVERTER=auto
ODA_FILE_CONVERTER_PATH=
LIBREDWG_DWG2DXF_PATH=
CONVERTER_TIMEOUT_S=120

# --- Local LLM (OpenAI-compatible; Ollama / llama.cpp server / vLLM) ----------
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=
LOCAL_LLM_ENABLED=true

# --- Blender / Cycles ---------------------------------------------------------
# Path to the blender binary (Cycles renders and 360° panoramas).
BLENDER_EXECUTABLE=
# AUTO uses a GPU for panoramas when available; CPU forces the processor.
BLENDER_DEVICE=AUTO

# --- Placement ----------------------------------------------------------------
PLACEMENT_RANDOM_SEED=42
MAX_ITERATIONS=3
LOCAL_LLM_TIMEOUT_S=180

# --- Eval LLM (offline dev/CI only — NEVER used at runtime) --------------------
# LOCAL open-source evaluator by default (llama.cpp on :8081 serving
# Qwen2.5-7B-Instruct). Protocol is OpenAI-compatible; the runner probes
# GET $OPENAI_BASE_URL/models. Unreachable endpoint / absent model =>
# CapabilityError / "SKIPPED (capability: ...)". No silent fallback by design.
# Empty OPENAI_EVAL_MODEL adopts the endpoint's model only when exactly one is
# served. A hosted endpoint may be configured explicitly and then requires
# OPENAI_API_KEY.
OPENAI_BASE_URL=http://127.0.0.1:8081/v1
OPENAI_EVAL_MODEL=
OPENAI_API_KEY=
